{
  "version": 1,
  "allowed_hosts": [
    "api.github.com"
  ],
  "allowed_ports": [443],
  "methods": ["GET"],
  "timeout_ms": 10000,
  "max_request_bytes": 262144,
  "max_response_bytes": 1048576,
  "follow_redirects": false,
  "secret_headers": {
    "api.github.com": {
      "Authorization": {
        "secret": "github-read-token",
        "prefix": "Bearer "
      }
    }
  }
}

{
  "schemaVersion": 1,
  "policyId": "steerion-sdlc-gate-v1",
  "projectId": "bar",
  "repo": "steerion-labs/bounded-agent-runtime",
  "baseBranch": "main",
  "profile": "security-critical-runtime",
  "authority": {
    "automaticMerge": false,
    "automaticDeploy": false,
    "productiveActions": false,
    "externalCommunication": false,
    "externalSpend": false,
    "humanGateRequired": true
  },
  "requiredEvidence": {
    "exactHeadRequired": true,
    "changedFilesRequired": true,
    "existingCiMustPass": true,
    "independentReviewRequired": true,
    "useAgentSystemChecksWhenPresent": true
  },
  "externalAgentApps": {
    "installAutomatically": false,
    "mayBeSoleReleaseEvidence": false,
    "requiresHumanApprovalForInstallOrNewSpend": true
  },
  "requiredCommands": [
    "git diff --check",
    "npm run test"
  ],
  "preferredReviewers": [
    "bar-security-reviewer",
    "bar-review-orchestrator"
  ],
  "optionalExternalEvidence": [
    "endor-labs",
    "sonarqube"
  ],
  "deferredEvaluation": [],
  "rules": [
    "Authority, credential isolation, fencing, recovery and fail-closed behavior are release-blocking.",
    "Agent verdicts never replace deterministic adversarial evidence.",
    "No automatic merge or productive deployment."
  ],
  "policyIntegrity": {
    "candidatePolicyAuthoritative": false,
    "trustedPolicySource": "accepted-base",
    "candidateMayWeakenBase": false,
    "policyChangesRequireIndependentReview": true,
    "policyChangesRequireHumanGate": true,
    "bootstrapTrustFloor": [
      "AGENTS.md",
      "SECURITY.md"
    ]
  },
  "independentReview": {
    "controllerVerifiedAttestationRequired": true,
    "failClosedIfMissingOrUnverifiable": true,
    "exactCandidateBindingRequired": true,
    "distinctReviewerIdentityRequired": true,
    "separateWorkspaceRequired": true,
    "readOnlyReviewerRequired": true,
    "credentialSeparationRequired": true,
    "additionalTrustSeparationRequired": true,
    "allowedAdditionalSeparationFactors": [
      "provider",
      "model",
      "operator",
      "trust-domain"
    ],
    "requiredAttestationFields": [
      "candidate_sha",
      "tree_hash",
      "builder_identity",
      "reviewer_identity",
      "reviewer_workspace",
      "reviewer_read_only",
      "builder_credential_domain",
      "reviewer_credential_domain",
      "separation_factor",
      "separation_factor_value"
    ]
  }
}
